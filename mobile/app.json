{
  "expo": {
    "name": "TimeTap",
    "slug": "timetap",
    "scheme": "timetap",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.timetap.app"
    },
    "android": {
      "package": "com.timetap.app",
      "adaptiveIcon": {
        "backgroundColor": "#2369A5",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      "expo-web-browser",
      "expo-sharing",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "backgroundColor": "#F5F9FB"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Used to scan the QR code at check-in/check-out — no photos are taken or stored."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Used to verify you're at your worksite when you check in or out. Never collected in the background."
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-notifications"
    ],
    "extra": {
      "eas": {
        "projectId": "2fc7ad99-451f-457f-a2cd-237bb0a81342"
      }
    },
    "owner": "farabi07"
  }
}
